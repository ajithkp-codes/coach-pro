# CoachPro — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase project.
# Supabase Dashboard → Project Settings → API

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (SERVER ONLY — bypasses RLS). Used for seeding and admin tasks.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used to build password-reset / email-confirmation links.
# Leave blank in local dev (the request host is used). Set it in production,
# e.g. https://coachpro.yourdomain.com
NEXT_PUBLIC_SITE_URL=

# --- Razorpay (subscriptions) — optional; upgrades are disabled until set ---
# From the Razorpay Dashboard (use TEST keys while developing).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Per-tier Plans you create in Razorpay (Subscriptions → Plans), e.g. plan_XXXXXXXX.
# Create each at the price you intend to charge (launch promo: Pro ₹499, Studio ₹749).
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_STUDIO=
# Legacy single-plan id — still read as a fallback for Pro if _PRO is unset.
RAZORPAY_PLAN_ID=
# Webhook signing secret (Razorpay Dashboard → Webhooks) for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# --- AI import — optional; powers "AI import" in the Excel importer (SERVER ONLY) ---
# Provider-agnostic: any key works. The provider is inferred from the key
# (sk-ant-… → Anthropic, AIza…/AQ.… → Gemini, otherwise OpenAI-compatible).
# Without a key, the importer falls back to manual column mapping only.
AI_API_KEY=
# Optional overrides:
# AI_PROVIDER=openai|anthropic|gemini   (force the provider)
# AI_MODEL=                              (e.g. gemini-3.8-flash, claude-sonnet-5-5, gpt-4o-mini)
# AI_BASE_URL=                           (OpenAI-compatible gateway base, e.g. https://openrouter.ai/api/v1)

# --- Email (Titan / GoDaddy) — app-sent welcome + admin signup alerts ---
# SERVER ONLY. Same mailbox you set as Supabase custom SMTP (Auth → Emails).
# Supabase sends the confirm/reset links; these vars send our own messages.
# Note: GoDaddy-provisioned Titan mailboxes send via secureserver, not smtp.titan.email.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=ajith@coachpro.co.in
SMTP_PASS=
# From header for app-sent mail (display name + address)
MAIL_FROM=CoachPro <ajith@coachpro.co.in>
# Where new-signup alerts go (usually your own address)
ADMIN_NOTIFY_EMAIL=ajith@coachpro.co.in
